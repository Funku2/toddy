---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found" noindex>
  <section class="page-head">
    <div class="wrap narrow">
      <p class="eyebrow">404</p>
      <h1>That page isn't here.</h1>
      <p class="lede">It may have moved. Try the home page or the articles.</p>
      <p style="margin-top:2rem;display:flex;gap:14px;flex-wrap:wrap"><a class="btn" href="/">Home</a><a class="btn ghost" href="/articles/">Articles</a></p>
    </div>
  </section>
</Base>
