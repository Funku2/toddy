---
import Base from '../layouts/Base.astro';
import { site } from '../site.config';
---
<Base title={`Thank you | ${site.fullName}`} plainHeader noindex>
  <div class="wrap doc center">
    <p class="eyebrow centered">Received</p>
    <h1>Thank <em>you.</em></h1>
    <p class="lede">Your request is with our team. We will be in touch within {site.replyWindow} to arrange your consultation.</p>
    <p style="margin-top:2rem"><a class="btn ghost" href="/">Return home</a></p>
  </div>
</Base>
